# HTTPS for scinova.solutions. Caddy obtains the certificate once port 80
# and the DNS A record both reach this VM. Delete this file to remove it.
{
	servers {
		protocols h1 h2
	}
}

scinova.solutions {
	# Browsers remember the old HTTP/3 offer for 30 days. A proxy that
	# blocks that route then breaks the domain while the direct port works.
	header Alt-Svc clear
	reverse_proxy frontend:5173
}
